<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Production Screen - Print Queue</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; background-color: #1e293b; color: white; }
    h1 { color: #38bdf8; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 20px; }
    .card { background: #334155; padding: 20px; border-radius: 8px; border-left: 6px solid #94a3b8; }
    .card.Pending { border-left-color: #f59e0b; }
    .card.Printing { border-left-color: #3b82f6; }
    .card.Completed { border-left-color: #22c55e; }
    .btn { padding: 8px 12px; margin-right: 5px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    .btn-print { background: #3b82f6; color: white; }
    .btn-complete { background: #22c55e; color: white; }
    .btn-delete { background: #ef4444; color: white; }
  </style>
</head>
<body>

  <h1>🏭 Production Display (Real-Time Queue)</h1>
  <div class="grid" id="productionGrid"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const productionGrid = document.getElementById('productionGrid');

    function createJobCard(job) {
      const card = document.createElement('div');
      card.className = `card ${job.status}`;
      card.id = `prod-job-${job.id}`;
      card.innerHTML = `
        <h2>#${job.id} - ${job.filename}</h2>
        <p><strong>Copies:</strong> ${job.copies}</p>
        <p><strong>Time:</strong> ${job.createdAt}</p>
        <p><strong>Status:</strong> <span id="prod-status-${job.id}">${job.status}</span></p>
        <div>
          <button class="btn btn-print" onclick="updateStatus(${job.id}, 'Printing')">Start Printing</button>
          <button class="btn btn-complete" onclick="updateStatus(${job.id}, 'Completed')">Mark Done</button>
          <button class="btn btn-delete" onclick="removeJob(${job.id})">Clear</button>
        </div>
      `;
      return card;
    }

    function updateStatus(id, status) {
      socket.emit('update_job_status', { id, status });
    }

    function removeJob(id) {
      socket.emit('remove_job', id);
    }

    // Socket Events
    socket.on('initial_queue', (queue) => {
      productionGrid.innerHTML = '';
      queue.forEach(job => productionGrid.appendChild(createJobCard(job)));
    });

    socket.on('job_added', (job) => {
      productionGrid.appendChild(createJobCard(job));
    });

    socket.on('job_status_updated', (data) => {
      const card = document.getElementById(`prod-job-${data.id}`);
      const statusSpan = document.getElementById(`prod-status-${data.id}`);
      if (card && statusSpan) {
        statusSpan.textContent = data.status;
        card.className = `card ${data.status}`;
      }
    });

    socket.on('job_removed', (id) => {
      const card = document.getElementById(`prod-job-${id}`);
      if (card) card.remove();
    });
  </script>
</body>
</html>